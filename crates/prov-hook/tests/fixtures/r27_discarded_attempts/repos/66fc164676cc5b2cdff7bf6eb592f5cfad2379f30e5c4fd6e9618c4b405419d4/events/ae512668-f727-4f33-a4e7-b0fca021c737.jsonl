{"schema_version":"prov.event/0.1","event":"ai_change","timestamp":1794313789428092600,"hook_event_name":"PostToolUse","repo_id":"66fc164676cc5b2cdff7bf6eb592f5cfad2379f30e5c4fd6e9618c4b405419d4","path":"README.md","before_sha":"039b1e76c3e5639948181f9706fa26fad21ab72ce351ae487b4c11e8fbe8f286","after_sha":"2cbdd85d4ce2493ee1c563dbcaddafc8f792f3a17ead13fb3e50ea73461f9cd0","line_ranges":[[8,8],[13,14]],"deleted_at":[],"session_id":"ae512668-f727-4f33-a4e7-b0fca021c737","turn_id":null,"tool_use_id":"call_0PbZEuyWCC9gvEwPwDbMwrTH__vscode-1794313547670","model":null,"tool":"vscode-copilot","operation":"apply_patch","structured_edit":true,"structured_added_lines":["    \"start\": \"node index.js\",","    \"test\": \"node --test\"","node index.js add \"Submit report\" --due 2026-11-15 --priority high","The `--due` option accepts a real date in `YYYY-MM-DD` format. The `--priority` option accepts `low`, `medium`, or `high` and defaults to `medium`. Tasks are listed from highest to lowest priority, with overdue unfinished tasks shown in red.","","Tasks are stored in `tasks.json` in the project directory. Use `npm link` to install the `tasktrack` command globally from this checkout.","const assert = require('node:assert/strict');","const fs = require('node:fs');","const os = require('node:os');","const path = require('node:path');","const test = require('node:test');","","const { addTask, formatTasks, isValidDueDate, readTasks } = require('../index');","","test('validates real YYYY-MM-DD dates, including leap days', () => {","  assert.equal(isValidDueDate('2024-02-29'), true);","  assert.equal(isValidDueDate('2025-02-29'), false);","  assert.equal(isValidDueDate('2026-13-01'), false);","  assert.equal(isValidDueDate('2026-1-01'), false);","});","","test('persists due date and priority and defaults priority to medium', (context) => {","  const directory = fs.mkdtempSync(path.join(os.tmpdir(), 'tasktrack-'));","  context.after(() => fs.rmSync(directory, { recursive: true, force: true }));","  const file = path.join(directory, 'tasks.json');","","  const urgent = addTask('Submit report', { due: '2026-11-15', priority: 'high' }, file);","  const ordinary = addTask('Buy groceries', {}, file);","","  assert.deepEqual(urgent, {","    id: 1,","    description: 'Submit report',","    done: false,","    priority: 'high',","    due: '2026-11-15',","  });","  assert.equal(ordinary.priority, 'medium');","  assert.deepEqual(readTasks(file), [urgent, ordinary]);","});","","test('rejects invalid dates without writing a task', (context) => {","  const directory = fs.mkdtempSync(path.join(os.tmpdir(), 'tasktrack-'));","  context.after(() => fs.rmSync(directory, { recursive: true, force: true }));","  const file = path.join(directory, 'tasks.json');","","  assert.throws(() => addTask('Invalid date', { due: '2026-02-30' }, file), /valid date/);","  assert.deepEqual(readTasks(file), []);","});","","test('lists tasks by priority and highlights only overdue unfinished tasks', () => {","  const lines = formatTasks([","    { id: 1, description: 'Medium overdue', priority: 'medium', due: '2026-11-09', done: false },","    { id: 2, description: 'High due today', priority: 'high', due: '2026-11-10', done: false },","    { id: 3, description: 'Low completed', priority: 'low', due: '2026-11-01', done: true },","    { id: 4, description: 'High second', priority: 'high', done: false },","  ], '2026-11-10');","","  assert.deepEqual(lines, [","    '[ ] #2 High due today',","    '[ ] #4 High second',","    '\\u001b[31m[ ] #1 Medium overdue\\u001b[0m',","    '[x] #3 Low completed',","  ]);","});"],"structured_input_sha256":"881dfc88226e155be1e740c71ff893bfeb29cec5850f8337fe2f19d301b6f222","command_sha256":null,"command_length":null,"window_open":1794313780257204100,"window_close":1794313789428084500,"overlap":false,"degraded":null,"reason":null,"excluded":false,"after_incomplete":false,"head":"360b8d29054a24ef162144df76753807e1a04cd5","branch":"feature/tasks","head_moved"