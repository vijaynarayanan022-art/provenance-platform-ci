{"schema_version":"prov.event/0.1","event":"ai_change","timestamp":1794313747468452900,"hook_event_name":"PostToolUse","repo_id":"66fc164676cc5b2cdff7bf6eb592f5cfad2379f30e5c4fd6e9618c4b405419d4","path":"index.js","before_sha":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","after_sha":"06de891638aa91593b41e6a485c32a5692ca8654d18142d43a572d69ca24ec3f","line_ranges":[[1,124]],"deleted_at":[],"session_id":"ae512668-f727-4f33-a4e7-b0fca021c737","turn_id":null,"tool_use_id":"call_I3r1R2MuuiDi7UPcoSibQ6FV__vscode-1794313547668","model":null,"tool":"vscode-copilot","operation":"apply_patch","structured_edit":true,"structured_added_lines":["#!/usr/bin/env node","","const { Command, Option } = require('commander');","const fs = require('node:fs');","const path = require('node:path');","","const program = new Command();","const tasksFile = path.join(__dirname, 'tasks.json');","const priorityOrder = { high: 0, medium: 1, low: 2 };","","function readTasks(file = tasksFile) {","  try {","    const data = fs.readFileSync(file, 'utf8');","    const tasks = JSON.parse(data);","    if (!Array.isArray(tasks)) {","      throw new Error('The tasks file must contain a JSON array.');","    }","    return tasks;","  } catch (error) {","    if (error.code === 'ENOENT') return [];","    throw error;","  }","}","","function writeTasks(tasks, file = tasksFile) {","  fs.writeFileSync(file, `${JSON.stringify(tasks, null, 2)}\\n`, 'utf8');","}","","function isValidDueDate(due) {","  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(due)) return false;","  const date = new Date(`${due}T00:00:00.000Z`);","  return !Number.isNaN(date.getTime()) && date.toISOString().slice(0, 10) === due;","}","","function addTask(description, options = {}, file = tasksFile) {","  if (options.due !== undefined && !isValidDueDate(options.due)) {","    throw new Error('Due date must be a valid date in YYYY-MM-DD format.');","  }","  if (options.priority !== undefined && !Object.hasOwn(priorityOrder, options.priority)) {","    throw new Error('Priority must be low, medium, or high.');","  }","","  const tasks = readTasks(file);","  const id = tasks.reduce((highest, task) => Math.max(highest, task.id), 0) + 1;","  const task = { id, description, done: false, priority: options.priority ?? 'medium' };","  if (options.due !== undefined) task.due = options.due;","  tasks.push(task);","  writeTasks(tasks, file);","  return task;","}","","function localDateString(date = new Date()) {","  const year = date.getFullYear();","  const month = String(date.getMonth() + 1).padStart(2, '0');","  const day = String(date.getDate()).padStart(2, '0');","  return `${year}-${month}-${day}`;","}","","function formatTasks(tasks, today = localDateString()) {","  return [...tasks]","    .sort((left, right) => (priorityOrder[left.priority] ?? 1) - (priorityOrder[right.priority] ?? 1))","    .map((task) => {","      const line = `${task.done ? '[x]' : '[ ]'} #${task.id} ${task.description}`;","      return !task.done && task.due && task.due < today ? `\\u001b[31m${line}\\u001b[0m` : line;","    });","}","","program","  .name('tasktrack')","  .description('A simple command-line task tracker')","  .version('1.0.0');","","program","  .command('add <description>')","  .description('Add a task')","  .option('--due <date>', 'Due date in YYYY-MM-DD format')","  .addOption(new Option('--priority <priority>', 'Task priority').choices(['low', 'medium', 'high']))","  .action((description, options) => {","    try {","      const task = addTask(description, options);","      console.log(`Added task #${task.id}: ${description}`);","    } catch (error) {","      console.error(error.message);","      process.exitCode = 1;","    }","  });","","program","  .command('list')","  .description('List all tasks')","  .action(() => {","    const tasks = readTasks();","    if (tasks.length === 0) {","      console.log('No tasks yet. Add one with: tasktrack add \"Your task\"');","      return;","    }","    for (const line of formatTasks(tasks)) console.log(line);","  });","","program","  .command('done <id>')","  .description('Mark a task as done')","  .action((rawId) => {","    const id = Number(rawId);","    if (!Number.isInteger(id) || id < 1) {","      console.error('Task ID must be a positive integer.');","      process.exitCode = 1;","      return;","    }","    const tasks = readTasks();","    const task = tasks.find((item) => item.id === id);","    if (!task) {","      console.error(`Task #${id} was not found.`);","      process.exitCode = 1;","      return;","    }","    task.done = true;","    writeTasks(tasks);","    console.log(`Marked task #${id} as done.`);","  });","","if (require.main === module) program.parse();","","module.exports = { addTask, formatTasks, isValidDueDate, readTasks, writeTasks };"],"structured_input_sha256":"a8cb385ec7f1e077769534908847c119bd3653e924a69507d02e5e31bac73661","command_sha256":null,"command_length":null,"window_open":1794313744311554300,"window_close":1794313747468447400,"overlap":false,"degraded":null,"reason":null,"excluded":false,"after_incomplete":false,"head":"360b8d29054a24ef162144df76753807e1a04cd5","branch":"feature/tasks","head_moved":null,"old_head":null,"new_head":null,"branch_before":null,"branch_after":null,"file_count":null,"paths":null,"truncated":null,"commit_in_window":null,"dirty_count":null,"remaining":null,"bulk_partial":null}
