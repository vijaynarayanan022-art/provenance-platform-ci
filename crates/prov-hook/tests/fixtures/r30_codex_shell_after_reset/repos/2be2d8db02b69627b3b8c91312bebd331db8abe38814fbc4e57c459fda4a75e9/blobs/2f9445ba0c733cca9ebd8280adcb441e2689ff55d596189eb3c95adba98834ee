def read_amount(prompt):
    """Read a non-negative decimal amount."""
    while True:
        try:
            amount = float(input(prompt))
        except ValueError:
            print("Enter a valid number, such as 24.50.")
            continue
        if amount >= 0:
            return amount
        print("The amount cannot be negative.")


def main():
    print("Tip Calculator")
    bill = read_amount("Bill total: $")
    rate = read_amount("Tip percentage: ")
    people = int(read_amount("Number of people: "))
    if people < 1:
        print("There must be at least one person.")
        return
    tip = bill * rate / 100
    total = bill + tip
    share = total / people
    print()
    print(f"Bill:       ${bill:,.2f}")
    print(f"Tip ({rate:g}%):  ${tip:,.2f}")
    print(f"Total:      ${total:,.2f}")
    print(f"Each pays:  ${share:,.2f}")
    print("Thanks for using the calculator!")


if __name__ == "__main__":
    main()

