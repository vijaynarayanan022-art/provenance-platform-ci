import random


def read_integer(prompt, low, high):
    """Ask until the player enters an integer in range."""
    while True:
        text = input(prompt).strip()
        try:
            value = int(text)
        except ValueError:
            print("Please enter a whole number.")
            continue
        if low <= value <= high:
            return value
        print(f"Choose a number from {low} to {high}.")


def play_round():
    low, high = 1, 100
    target = random.randint(low, high)
    turns = 0
    print(f"I picked a number from {low} to {high}.")
    while True:
        guess = read_integer("Your guess: ", low, high)
        turns += 1
        if guess < target:
            print("Too low. Try a larger number.")
        elif guess > target:
            print("Too high. Try a smaller number.")
        else:
            print(f"Correct! You needed {turns} guesses.")
            return turns


def main():
    print("Number Guessing Game")
    best_score = None
    while True:
        score = play_round()
        if best_score is None or score < best_score:
            best_score = score
            print("That is your best score so far!")
        again = input("Play again? (y/n): ").strip().lower()
        if again != "y":
            break
    print(f"Best score: {best_score} guesses.")
    print("Thanks for playing!")


if __name__ == "__main__":
    main()
