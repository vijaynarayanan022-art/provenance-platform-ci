const { InvalidArgumentError } = require('commander');

const priorityOrder = { high: 0, medium: 1, low: 2 };

function parseDueDate(value) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) {
    throw new InvalidArgumentError('Due date must use YYYY-MM-DD format.');
  }

  const parsed = new Date(`${value}T00:00:00.000Z`);
  if (Number.isNaN(parsed.getTime()) || parsed.toISOString().slice(0, 10) !== value) {
    throw new InvalidArgumentError('Due date must be a valid calendar date.');
  }

  return value;
}

function parsePriority(value) {
  if (!Object.hasOwn(priorityOrder, value)) {
    throw new InvalidArgumentError('Priority must be low, medium, or high.');
  }
  return value;
}

function sortTasks(tasks) {
  return [...tasks].sort((left, right) => {
    const leftPriority = priorityOrder[left.priority] ?? priorityOrder.medium;
    const rightPriority = priorityOrder[right.priority] ?? priorityOrder.medium;
    return leftPriority - rightPriority || left.id - right.id;
  });
}

function isOverdue(task, today = new Date().toISOString().slice(0, 10)) {
  return !task.done && typeof task.due === 'string' && task.due < today;
}

function clearDoneTasks(tasks) {
  return tasks.filter((task) => !task.done);
}

module.exports = { clearDoneTasks, isOverdue, parseDueDate, parsePriority, sortTasks };