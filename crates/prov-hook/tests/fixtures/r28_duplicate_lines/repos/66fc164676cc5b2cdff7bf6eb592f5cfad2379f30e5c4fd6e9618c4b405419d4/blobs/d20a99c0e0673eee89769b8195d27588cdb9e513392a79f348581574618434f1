#!/usr/bin/env node

const { Command } = require('commander');
const fs = require('node:fs');
const path = require('node:path');
const { clearDoneTasks, isOverdue, parseDueDate, parsePriority, sortTasks } = require('./task-utils');

const program = new Command();
const tasksFile = path.join(__dirname, 'tasks.json');

function readTasks() {
  try {
    const data = fs.readFileSync(tasksFile, 'utf8');
    const tasks = JSON.parse(data);
    if (!Array.isArray(tasks)) {
      throw new Error('The tasks file must contain a JSON array.');
    }
    return tasks;
  } catch (error) {
    if (error.code === 'ENOENT') return [];
    throw error;
  }
}

function writeTasks(tasks) {
  fs.writeFileSync(tasksFile, `${JSON.stringify(tasks, null, 2)}\n`, 'utf8');
}

program
  .name('tasktrack')
  .description('A simple command-line task tracker')
  .version('1.0.0');

program
  .command('add <description>')
  .description('Add a task')
  .option('--due <date>', 'Due date (YYYY-MM-DD)', parseDueDate)
  .option('--priority <priority>', 'Priority (low, medium, or high)', parsePriority)
  .action((description, options) => {
    const tasks = readTasks();
    const id = tasks.reduce((highest, task) => Math.max(highest, task.id), 0) + 1;
    const task = {
      id,
      description,
      done: false,
      ...(options.due ? { due: options.due } : {}),
      ...(options.priority ? { priority: options.priority } : {}),
    };
    tasks.push(task);
    writeTasks(tasks);
    console.log(`Added task #${id}: ${description}`);
  });

program
  .command('list')
  .description('List all tasks')
  .action(() => {
    const tasks = readTasks();
    if (tasks.length === 0) {
      console.log('No tasks yet. Add one with: tasktrack add "Your task"');
      return;
    }

    for (const task of sortTasks(tasks)) {
      const due = task.due ? ` (due ${task.due})` : '';
      const priority = task.priority ? ` [${task.priority}]` : '';
      const line = `${task.done ? '[x]' : '[ ]'} #${task.id} ${task.description}${priority}${due}`;
      console.log(isOverdue(task) ? `\x1b[31m${line}\x1b[0m` : line);
    }
  });

program
  .command('clear')
  .description('Remove completed tasks')
  .option('--done', 'Remove completed tasks')
  .action((options) => {
    if (!options.done) {
      console.error('Specify --done to remove completed tasks.');
      process.exitCode = 1;
      return;
    }

    const tasks = readTasks();
    const remainingTasks = clearDoneTasks(tasks);
    writeTasks(remainingTasks);
    console.log(`Removed ${tasks.length - remainingTasks.length} completed task(s).`);
  });

program
  .command('done <id>')
  .description('Mark a task as done')
  .action((rawId) => {
    const id = Number(rawId);
    if (!Number.isInteger(id) || id < 1) {
      console.error('Task ID must be a positive integer.');
      process.exitCode = 1;
      return;
    }

    const tasks = readTasks();
    const task = tasks.find((item) => item.id === id);
    if (!task) {
      console.error(`Task #${id} was not found.`);
      process.exitCode = 1;
      return;
    }

    task.done = true;
    writeTasks(tasks);
    console.log(`Marked task #${id} as done.`);
  });

program.parse();
